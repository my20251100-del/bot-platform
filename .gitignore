# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext cloudflare build output
/.open-next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.local

# dev only cloudflare vars (never commit)
.dev.vars

# wrangler local state
/.wrangler/

# vercel
.vercel
.vercel-token

# whatsapp-web.js local sessions (parallel Express backend)
/server/node_modules/
/server/.sessions/
/server/.env
/server/.wwebjs_auth/
/server/.wwebjs_cache/

# root Baileys engine sessions (engine/index.mjs runtime data)
/sessions/
/engine.log
/vps/

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts with embedded secrets (run locally, never push)
/scripts/
